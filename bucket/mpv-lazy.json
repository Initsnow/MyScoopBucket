    "url": [
        "https://github.com/hooke007/mpv_PlayKit/releases/download/20260510/mpv-lazy-20260510-noVS.7z",
        "https://github.com/hooke007/mpv_PlayKit/releases/download/20260510/mpv-lazy-20260510-vsNV.7z.001",
        "https://github.com/hooke007/mpv_PlayKit/releases/download/20260510/mpv-lazy-20260510-vsNV.7z.002"
    ],
    "hash": [
        "cd8373316417ddf9a688d3f52aa47e1c67e863aef68cf5dba380c57f41b2c855",
        "f877973fae54d7cc05451d0369340f5a4ef6c82a2f633c66b786a337d3e6ddda",
        "1c7303d76f3767f16122c5ea16894add08b6c044ab15d2ccefba6155b8782007"
    ],
    "extract_dir": [
        "mpv-lazy",
        "mpv-lazy"
    ],
    "bin": "mpv.exe",
    "post_install": [
        "$utf8NoBom = New-Object System.Text.UTF8Encoding($false)",
        "function Read-Utf8File($path) { [System.IO.File]::ReadAllText($path, [System.Text.Encoding]::UTF8) }",
        "function Write-Utf8File($path, $content) { [System.IO.File]::WriteAllText($path, $content, $utf8NoBom) }",
        "function Apply-Replace($content, $pattern, $replacement, $label) {",
        "    $count = [regex]::Matches($content, $pattern).Count",
        "    if ($count -ne 1) { throw \"mpv-lazy 补丁未命中 $label ：模式 $pattern 匹配到 $count 处（期望恰好 1 处）\" }",
        "    return [regex]::Replace($content, $pattern, $replacement)",
        "}",
        "$patchReport = @()",
        "$mpvConf = Join-Path $dir 'portable_config\\mpv.conf'",
        "$profilesConf = Join-Path $dir 'portable_config\\profiles.conf'",
        "$autoHwdecScript = Join-Path $dir 'portable_config\\scripts\\auto_hwdec_for_vf.lua'",
        "$mpv = Read-Utf8File $mpvConf",
        "$mpv = Apply-Replace $mpv '(?m)^\\s*hwdec\\s*=\\s*auto-copy[ \\t]*$' ' hwdec = auto' 'mpv.conf hwdec'",
        "Write-Utf8File $mpvConf $mpv",
        "$patchReport += 'mpv.conf: OK'",
        "$highResProfile = @'",
        "[high_res_perf]",
        " profile-desc = 基于像素数的高分辨率性能保护",
        " profile-cond = ((p.width or 0) * (p.height or 0))>=6144000",
        " profile-restore = copy",
        " interpolation = no",
        " video-sync = audio",
        "",
        "'@",
        "$profiles = Read-Utf8File $profilesConf",
        "if ($profiles -match '(?m)^\\[high_res_perf\\]\\s*$') {",
        "    $patchReport += 'profiles.conf: OK (已存在)'",
        "} else {",
        "    if ($profiles -match '(?m)^\\[deband_bitrate\\]') {",
        "        $profiles = Apply-Replace $profiles '(?m)^\\[deband_bitrate\\]' ($highResProfile + \"`r`n[deband_bitrate]\") 'profiles.conf deband_bitrate 前插入'",
        "    } else {",
        "        $profiles = $profiles.TrimEnd() + \"`r`n`r`n\" + $highResProfile + \"`r`n\"",
        "    }",
        "    if ($profiles -notmatch '(?m)^\\[high_res_perf\\]\\s*$') { throw 'profiles.conf: high_res_perf 插入后校验失败' }",
        "    Write-Utf8File $profilesConf $profiles",
        "    $patchReport += 'profiles.conf: OK'",
        "}",
        "$autoHwdecForVf = @'",
        "local mp = require \"mp\"",
        "",
        "local normal_hwdec = \"auto\"",
        "local vf_hwdec = \"auto-copy\"",
        "local managed_hwdec = {",
        "    [normal_hwdec] = true,",
        "    [vf_hwdec] = true,",
        "}",
        "",
        "local function has_vf(filters)",
        "    if type(filters) == \"table\" then",
        "        return #filters > 0",
        "    end",
        "    if type(filters) == \"string\" then",
        "        return filters ~= \"\" and filters ~= \"(empty)\"",
        "    end",
        "    return false",
        "end",
        "",
        "local function apply_hwdec_for_vf(_, filters)",
        "    local target = has_vf(filters) and vf_hwdec or normal_hwdec",
        "    local current = mp.get_property(\"hwdec\", normal_hwdec)",
        "",
        "    if current == target or not managed_hwdec[current] then",
        "        return",
        "    end",
        "",
        "    mp.set_property(\"hwdec\", target)",
        "    mp.msg.info(\"set hwdec=\" .. target .. \" for \" .. (has_vf(filters) and \"vf\" or \"normal playback\"))",
        "end",
        "",
        "mp.observe_property(\"vf\", \"native\", apply_hwdec_for_vf)",
        "mp.register_event(\"file-loaded\", function()",
        "    apply_hwdec_for_vf(nil, mp.get_property_native(\"vf\"))",
        "end)",
        "'@",
        "Write-Utf8File $autoHwdecScript $autoHwdecForVf",
        "if ((Read-Utf8File $autoHwdecScript) -ne $autoHwdecForVf) { throw 'auto_hwdec_for_vf.lua 写入校验失败' }",
        "$patchReport += 'auto_hwdec_for_vf.lua: OK'",
        "$inputUoscConf = Join-Path $dir 'portable_config\\input_uosc.conf'",
        "$inputUosc = Read-Utf8File $inputUoscConf",
        "$inputUosc = Apply-Replace $inputUosc '(?m)^\\s*Ctrl\\+s\\s+screenshot\\s+scaled\\+subtitles\\s*#!.*$' (' Ctrl+s' + (' ' * 12) + 'screenshot scaled' + (' ' * 37) + '#! 截屏 > 窗口（无OSD 无字幕）') 'input_uosc.conf Ctrl+s'",
        "$inputUosc = Apply-Replace $inputUosc '(?m)^\\s*Ctrl\\+S\\s+screenshot\\s+window\\s*#!\\s*截屏\\s*>\\s*窗口[ \\t]*$' (' Ctrl+S' + (' ' * 12) + 'screenshot window' + (' ' * 37) + '#! 截屏 > 窗口（所见即所得 含字幕+OSD）') 'input_uosc.conf Ctrl+S'",
        "$inputUosc = Apply-Replace $inputUosc '(?m)^\\s*#\\s+screenshot\\s+video\\s*#!\\s*截屏\\s*>\\s*原始[ \\t]*$' (('#' + (' ' * 18) + 'screenshot scaled+subtitles' + (' ' * 27) + '#! 截屏 > 窗口（无OSD 含字幕）') + \"`n\" + ('#' + (' ' * 18) + 'screenshot video' + (' ' * 38) + '#! 截屏 > 原始（无字幕）')) 'input_uosc.conf 原始行'",
        "Write-Utf8File $inputUoscConf $inputUosc",
        "$patchReport += 'input_uosc.conf: OK'",
        "$menuConf = Join-Path $dir 'portable_config\\menu.conf'",
        "$menu = Read-Utf8File $menuConf",
        "$menu = Apply-Replace $menu '(?m)^[ \\t]*窗口-无OSD[ \\t]*\\(&S\\)[ \\t]+screenshot[ \\t]+scaled\\+subtitles[^\\r\\n]*$' \"`t窗口-无OSD-无字幕 (&S)`t`tscreenshot scaled\" 'menu.conf 窗口-无OSD'",
        "$menu = Apply-Replace $menu '(?m)^[ \\t]*窗口[ \\t]*\\(&W\\)[ \\t]+screenshot[ \\t]+window[^\\r\\n]*$' \"`t窗口-所见即所得 (&W)`t`tscreenshot window\" 'menu.conf 窗口'",
        "$menu = Apply-Replace $menu '(?m)^[ \\t]*原始[ \\t]*\\(&V\\)[ \\t]+screenshot[ \\t]+video[^\\r\\n]*$' \"`t原始-无字幕 (&V)`t`t`tscreenshot video\" 'menu.conf 原始'",
        "$menu = Apply-Replace $menu '(?m)^([ \\t]*窗口-无OSD-无字幕[^\\r\\n]*\\r?\\n)' ('$1' + \"`t窗口-含字幕-无OSD (&T)`t`tscreenshot scaled+subtitles`n\") 'menu.conf 插入含字幕项'",
        "Write-Utf8File $menuConf $menu",
        "$patchReport += 'menu.conf: OK'",
        "$uoscMain = Join-Path $dir 'portable_config\\scripts\\uosc\\main.lua'",
        "$uoscMainContent = Read-Utf8File $uoscMain",
        "$uoscMainContent = Apply-Replace $uoscMainContent \"value = 'screenshot scaled\\+subtitles'\" \"value = 'screenshot scaled'\" 'uosc/main.lua 截屏项'",
        "Write-Utf8File $uoscMain $uoscMainContent",
        "$patchReport += 'uosc/main.lua: OK'",
        "$uoscLang = Join-Path $dir 'portable_config\\scripts\\uosc\\lib\\lang.lua'",
        "$uoscLangContent = Read-Utf8File $uoscLang",
        "$uoscLangContent = Apply-Replace $uoscLangContent \"_cm_ushot\\s*=\\s*'截屏（有字幕 无OSD）'\" \"_cm_ushot = '截屏（无字幕 无OSD）'\" 'uosc/lang.lua 标签'",
        "Write-Utf8File $uoscLang $uoscLangContent",
        "$patchReport += 'uosc/lang.lua: OK'",
        "$patchLogDir = Join-Path $dir 'portable_config\\_cache'",
        "if (!(Test-Path $patchLogDir)) { New-Item -ItemType Directory -Force -Path $patchLogDir | Out-Null }",
        "Write-Utf8File (Join-Path $patchLogDir 'mpv_lazy_patch_status.txt') (('mpv-lazy 补丁状态: 全部应用成功 ' + (Get-Date -Format 'yyyy-MM-dd HH:mm:ss') + \"`n\" + ($patchReport -join \"`n\")) + \"`n\")",
        "Write-Host 'mpv-lazy: 全部补丁已应用，状态见 portable_config\\_cache\\mpv_lazy_patch_status.txt'",
        "& \"$dir\\mpv.com\" --config=no --register"
    ],
    "pre_uninstall": "& \"$dir\\mpv.com\" --config=no --unregister",
    "shortcuts": [
        [
            "mpv.exe",
            "mpv"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "url": [
            "https://github.com/hooke007/mpv_PlayKit/releases/download/$version/mpv-lazy-$version-noVS.7z",
            "https://github.com/hooke007/mpv_PlayKit/releases/download/$version/mpv-lazy-$version-vsNV.7z.001",
            "https://github.com/hooke007/mpv_PlayKit/releases/download/$version/mpv-lazy-$version-vsNV.7z.002"
        ]
    }
}
